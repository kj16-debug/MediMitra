# Keep this file as a template. Put your real key in .env (never commit it).
# Demo mode uses deterministic responses and does not call Jarvislabs.
DEMO_MODE=1

# Local Ollama Gemma 4 (set the exact installed tag after checking `ollama list`).
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=ollama
LOCAL_MODEL=

# Jarvislabs Token Factory OpenAI-compatible API.
CLOUD_BASE_URL=https://models.jarvislabs.net/v1
JARVISLABS_API_KEY=
# Set the exact served model ID shown in your Jarvislabs account/catalog.
CLOUD_MODEL=gemma-4-26b-a4b-it

CLOUD_TIMEOUT_SECONDS=60
# Model request timeouts in seconds (CPU Gemma inference can be slow)
LOCAL_TIMEOUT_SECONDS=120
DEBUG_LOG=0

# Allowed CORS origins (comma-separated, no wildcard)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Emergency contact line for field health workers
SUPERVISOR_EMERGENCY_CONTACT="Contact your supervisor or local emergency services"
